{:paths ["src" "dev" "resources"]
 :deps  {cheshire/cheshire                       {:mvn/version "6.2.0"}
         clj-http/clj-http                       {:mvn/version "3.13.1"}
         com.github.seancorfield/next.jdbc       {:mvn/version "1.3.9999-SNAPSHOT"}
         com.stuartsierra/component              {:mvn/version "1.2.0"}
         com.stuartsierra/component.repl         {:mvn/version "1.0.0"}
         com.zaxxer/HikariCP                     {:mvn/version "7.1.0"}
         io.pedestal/pedestal.service            {:mvn/version "0.8.1"}
         io.pedestal/pedestal.route              {:mvn/version "0.8.1"}
         io.pedestal/pedestal.http-kit           {:mvn/version "0.8.1"}
         io.github.cdimascio/dotenv-java         {:mvn/version "3.2.0"}
